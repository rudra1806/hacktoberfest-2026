{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HacktoberfestManifest",
  "type": "object",
  "required": ["year", "owner", "username", "totalStickers", "stickers"],
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 2020
    },
    "edition": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "totalStickers": {
      "type": "integer",
      "minimum": 1
    },
    "stickerBookUrl": {
      "type": "string"
    },
    "stickers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayOrder", "name", "earned", "featured"],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "earned": {
            "type": "boolean"
          },
          "featured": {
            "type": "boolean"
          },
          "earnedDate": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": ["string", "null"]
          },
          "certificate": {
            "type": ["string", "null"]
          },
          "url": {
            "type": "string"
          },
          "accentColor": {
            "type": "string"
          }
        }
      }
    }
  }
}
